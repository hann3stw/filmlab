{
  "name": "filmlab",
  "private": true,
  "version": "0.3.1",
  "description": "FilmLab — Fujifilm in-camera RAW conversion & recipes as a PWA (WebUSB).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.cjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
